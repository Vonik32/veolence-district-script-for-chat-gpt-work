local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- SETTINGS
local SETTINGS = {
	Players = true,
	Killers = true,
	Generators = true,
	Hooked = true,
	Mode = "Outline"
}

local COLORS = {
	Player = Color3.fromRGB(0,255,255),
	Killer = Color3.fromRGB(255,0,0),
	Generator = Color3.fromRGB(255,255,0),
	Hooked = Color3.fromRGB(255,100,255)
}

-- GUI
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local Frame = Instance.new("Frame", ScreenGui)

Frame.Size = UDim2.new(0,250,0,300)
Frame.AnchorPoint = Vector2.new(0.5,0.5)
Frame.Position = UDim2.new(0.5,0,0.5,0)
Frame.BackgroundColor3 = Color3.fromRGB(20,20,20)
Frame.BorderSizePixel = 0

-- DRAG (фикс нормальный)
local dragging = false
local dragStart, startPos

Frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = Frame.Position
	end
end)

Frame.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		Frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

-- КНОПКИ
local function Button(text, y, callback)
	local b = Instance.new("TextButton", Frame)
	b.Size = UDim2.new(1,-10,0,30)
	b.Position = UDim2.new(0,5,0,y)
	b.Text = text
	b.BackgroundColor3 = Color3.fromRGB(40,40,40)
	b.TextColor3 = Color3.new(1,1,1)

	b.MouseButton1Click:Connect(callback)
end

Button("Players",10,function()
	SETTINGS.Players = not SETTINGS.Players
end)

Button("Killers",50,function()
	SETTINGS.Killers = not SETTINGS.Killers
end)

Button("Generators",90,function()
	SETTINGS.Generators = not SETTINGS.Generators
end)

Button("Hooked",130,function()
	SETTINGS.Hooked = not SETTINGS.Hooked
end)

Button("Mode",170,function()
	SETTINGS.Mode = SETTINGS.Mode == "Outline" and "Fill" or "Outline"
end)

-- ESP
local function ESP(obj,color)
	if not obj or obj:FindFirstChild("ESP") then return end

	local h = Instance.new("Highlight")
	h.Name = "ESP"
	h.Adornee = obj
	h.Parent = obj

	if SETTINGS.Mode == "Outline" then
		h.FillTransparency = 1
	else
		h.FillTransparency = 0.5
		h.FillColor = color
	end

	h.OutlineColor = color
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
end

-- LOOP
RunService.RenderStepped:Connect(function()

	if SETTINGS.Players then
		for _,p in pairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character then
				ESP(p.Character,COLORS.Player)
			end
		end
	end

	if SETTINGS.Killers then
		for _,p in pairs(Players:GetPlayers()) do
			if p.Character and p.Character:FindFirstChildOfClass("Tool") then
				ESP(p.Character,COLORS.Killer)
			end
		end
	end

	if SETTINGS.Generators then
