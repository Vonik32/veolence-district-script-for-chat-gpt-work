local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- SETTINGS
local SETTINGS = {
	Players = false,
	Killers = false,
	Generators = false,
	Hooked = false,
	Mode = "Outline"
}

-- COLORS
local COLORS = {
	Player = Color3.fromRGB(0,255,255),
	Killer = Color3.fromRGB(255,0,0),
	Generator = Color3.fromRGB(255,255,0),
	Hooked = Color3.fromRGB(255,0,255)
}

-- GUI
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local Frame = Instance.new("Frame", ScreenGui)

Frame.Size = UDim2.new(0,250,0,260)
Frame.AnchorPoint = Vector2.new(0.5,0.5)
Frame.Position = UDim2.new(0.5,0,0.5,0)
Frame.BackgroundColor3 = Color3.fromRGB(20,20,20)

-- DRAG
local dragging = false
local dragStart, startPos

Frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = Frame.Position
	end
end)

Frame.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		Frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

-- КНОПКА С КВАДРАТОМ
local function Toggle(name, y, setting)
	local btn = Instance.new("TextButton", Frame)
	btn.Size = UDim2.new(1,-10,0,30)
	btn.Position = UDim2.new(0,5,0,y)
	btn.Text = name
	btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
	btn.TextColor3 = Color3.new(1,1,1)

	local box = Instance.new("Frame", btn)
	box.Size = UDim2.new(0,20,0,20)
	box.Position = UDim2.new(1,-25,0.5,-10)
	box.BackgroundColor3 = Color3.fromRGB(80,80,80)

	btn.MouseButton1Click:Connect(function()
		SETTINGS[setting] = not SETTINGS[setting]
		box.BackgroundColor3 = SETTINGS[setting] and Color3.fromRGB(0,255,0) or Color3.fromRGB(80,80,80)
	end)
end

Toggle("Players",10,"Players")
Toggle("Killers",50,"Killers")
Toggle("Generators",90,"Generators")
Toggle("Hooked",130,"Hooked")

-- MODE
local modeBtn = Instance.new("TextButton", Frame)
modeBtn.Size = UDim2.new(1,-10,0,30)
modeBtn.Position = UDim2.new(0,5,0,170)
modeBtn.Text = "Mode: Outline"
modeBtn.BackgroundColor3 = Color3.fromRGB(40,40,40)
modeBtn.TextColor3 = Color3.new(1,1,1)

modeBtn.MouseButton1Click:Connect(function()
	SETTINGS.Mode = SETTINGS.Mode == "Outline" and "Fill" or "Outline"
	modeBtn.Text = "Mode: "..SETTINGS.Mode
end)

-- ESP CREATE
local function AddESP(obj,color)
	if not obj or obj:FindFirstChild("ESP") then return end

	local h = Instance.new("Highlight")
	h.Name = "ESP"
	h.Adornee = obj
	h.Parent = obj

	h.OutlineColor = color
	h.FillColor = color
	h.FillTransparency = SETTINGS.Mode == "Outline" and 1 or 0.5
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
end

local function RemoveESP(obj)
	if obj and obj:FindFirstChild("ESP") then
		obj.ESP:Destroy()
	end
end

-- LOOP
RunService.RenderStepped:Connect(function()

	for _,p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			if SETTINGS.Players then
				AddESP(p.Character, COLORS.Player)
			else
				RemoveESP(p.Character)
			end
		end
	end

	for _,p in pairs(Players:GetPlayers()) do
		if p.Character and p.Character:FindFirstChildOfClass("Tool") then
			if SETTINGS.Killers then
				AddESP(p.Character, COLORS.Killer)
			else
				RemoveESP(p.Character)
			end
		end
	end

	for _,v in pairs(workspace:GetDescendants()) do
		if v.Name:lower():find("generator") then
			if SETTINGS.Generators then
				AddESP(v, COLORS.Generator)
			else
				RemoveESP(v)
			end
		end
	end

	for _,p in pairs(Players:GetPlayers()) do
		if p.Character and p.Character:FindFirstChild("Hooked") then
			if SETTINGS.Hooked then
				AddESP(p.Character, COLORS.Hooked)
			else
				RemoveESP(p.Character)
			end
		end
	end

end)

-- KEYS
local open = true

UIS.InputBegan:Connect(function(input,gp)
	if gp then return end

	if input.KeyCode == Enum.KeyCode.Insert then
		open = not open
		Frame.Visible = open
	end

	if input.KeyCode == Enum.KeyCode.End then
		ScreenGui:Destroy()
	end
end)
