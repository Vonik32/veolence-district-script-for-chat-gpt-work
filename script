local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LP = Players.LocalPlayer

-- SETTINGS
local SETTINGS = {
	Players = false,
	Killers = false,
	Generators = false,
	Hooked = false,
	Mode = "Outline"
}

-- COLORS
local COLORS = {
	Player = Color3.fromRGB(0,255,255),
	Killer = Color3.fromRGB(255,0,0),
	Generator = Color3.fromRGB(255,255,0),
	Hooked = Color3.fromRGB(255,0,255)
}

-- STORAGE
local highlights = {}
local connections = {}

-- GUI
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local Frame = Instance.new("Frame", ScreenGui)

Frame.Size = UDim2.new(0,250,0,260)
Frame.AnchorPoint = Vector2.new(0.5,0.5)
Frame.Position = UDim2.new(0.5,0,0.5,0)
Frame.BackgroundColor3 = Color3.fromRGB(20,20,20)

-- DRAG
local dragging = false
local dragStart, startPos

Frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = Frame.Position
	end
end)

Frame.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		Frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

-- TOGGLE UI
local function Toggle(name, y, key)
	local btn = Instance.new("TextButton", Frame)
	btn.Size = UDim2.new(1,-10,0,30)
	btn.Position = UDim2.new(0,5,0,y)
	btn.Text = name
	btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
	btn.TextColor3 = Color3.new(1,1,1)

	local box = Instance.new("Frame", btn)
	box.Size = UDim2.new(0,20,0,20)
	box.Position = UDim2.new(1,-25,0.5,-10)
	box.BackgroundColor3 = Color3.fromRGB(80,80,80)

	btn.MouseButton1Click:Connect(function()
		SETTINGS[key] = not SETTINGS[key]
		box.BackgroundColor3 = SETTINGS[key] and Color3.fromRGB(0,255,0) or Color3.fromRGB(80,80,80)
	end)
end

Toggle("Players",10,"Players")
Toggle("Killers",50,"Killers")
Toggle("Generators",90,"Generators")
Toggle("Hooked",130,"Hooked")

-- MODE BUTTON
local modeBtn = Instance.new("TextButton", Frame)
modeBtn.Size = UDim2.new(1,-10,0,30)
modeBtn.Position = UDim2.new(0,5,0,170)
modeBtn.Text = "Mode: Outline"
modeBtn.BackgroundColor3 = Color3.fromRGB(40,40,40)
modeBtn.TextColor3 = Color3.new(1,1,1)

local function UpdateMode()
	for obj,hl in pairs(highlights) do
		if hl and hl.Parent then
			if SETTINGS.Mode == "Outline" then
				hl.FillTransparency = 1
			else
				hl.FillTransparency = 0.5
			end
		end
	end
end

modeBtn.MouseButton1Click:Connect(function()
	SETTINGS.Mode = SETTINGS.Mode == "Outline" and "Fill" or "Outline"
	modeBtn.Text = "Mode: "..SETTINGS.Mode
	UpdateMode()
end)

-- ESP FUNCTIONS
local function AddESP(obj,color)
	if not obj or highlights[obj] then return end
	
	local hl = Instance.new("Highlight")
	hl.Adornee = obj
	hl.Parent = obj
	hl.OutlineColor = color
	hl.FillColor = color
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	
	hl.FillTransparency = SETTINGS.Mode == "Outline" and 1 or 0.5
	
	highlights[obj] = hl
end

local function RemoveESP(obj)
	if highlights[obj] then
		highlights[obj]:Destroy()
		highlights[obj] = nil
	end
end

-- LOGIC
connections[#connections+1] = RunService.RenderStepped:Connect(function()

	for _,p in pairs(Players:GetPlayers()) do
		if p ~= LP and p.Character then
			
			local isKiller = p:FindFirstChild("Role") and tostring(p.Role.Value):lower():find("killer")
			local isHooked = p.Character:FindFirstChild("Hooked")

			if SETTINGS.Players and not isKiller then
				AddESP(p.Character, COLORS.Player)
			elseif SETTINGS.Killers and isKiller then
				AddESP(p.Character, COLORS.Killer)
			elseif SETTINGS.Hooked and isHooked then
				AddESP(p.Character, COLORS.Hooked)
			else
				RemoveESP(p.Character)
			end
		end
	end

	for _,v in pairs(workspace:GetDescendants()) do
		if v.Name:lower():find("generator") then
			if SETTINGS.Generators then
				AddESP(v, COLORS.Generator)
			else
				RemoveESP(v)
			end
		end
	end

end)

-- KEYS
local open = true

connections[#connections+1] = UIS.InputBegan:Connect(function(input,gp)
	if gp then return end
	
	if input.KeyCode == Enum.KeyCode.Insert then
		open = not open
		Frame.Visible = open
		UIS.MouseIconEnabled = open
	end
	
	if input.KeyCode == Enum.KeyCode.End then
		
		-- FULL UNLOAD
		for _,c in pairs(connections) do
			pcall(function() c:Disconnect() end)
		end
		
		for _,hl in pairs(highlights) do
			pcall(function() hl:Destroy() end)
		end
		
		highlights = {}
		
		if ScreenGui then
			ScreenGui:Destroy()
		end
		
		UIS.MouseIconEnabled = true
	end
end)
